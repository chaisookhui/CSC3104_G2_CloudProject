# Local development runtimes, database data, installers, and logs
.local/

# Python virtual environments and bytecode caches
.venv/
venv/
__pycache__/
*.py[cod]

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage output
.coverage
coverage.xml
htmlcov/

# Local environment secrets (keep example templates trackable)
.env
.env.*
!.env.example
!.env.sample
!.env.template
