# Copy to .env.core (ignored). Use distinct, randomly generated values.
# APP_DATABASE_PASSWORD must be URL-safe: e.g. Python secrets.token_hex(24).
POSTGRES_PASSWORD=replace_with_random_admin_password
APP_DATABASE_PASSWORD=replace_with_random_url_safe_app_password
PAYMENT_API_TOKEN=replace_with_a_private_token_at_least_32_characters
# Only the frontend is published, on host loopback. Internal APIs use Docker DNS.
FRONTEND_PORT=18080
HOLD_TTL_SECONDS=300
BATCH_SIZE=50
