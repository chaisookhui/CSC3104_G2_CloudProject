# Local demo only (all local workers use this same file):
ALLOCATION_DATABASE_URL=sqlite:////tmp/allocation-demo.sqlite3
# For separate machines/Pods, set a shared PostgreSQL database instead:
# ALLOCATION_DATABASE_URL=postgresql://user:password@postgres:5432/allocation
SEAT_STORE_URL=http://127.0.0.1:5003
# Add D only after SeatStore supports and seeds it.
ALLOCATION_SECTIONS=A,B,C

# Set to the dispatcher owner's agreed completion endpoint when integrated.
# Unset/empty means events remain pending; batch polling still works.
DISPATCHER_COMPLETION_URL=
