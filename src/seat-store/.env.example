# setup.ps1 creates .env with randomly generated local passwords.
POSTGRES_ADMIN_PASSWORD=replace_me
SEAT_STORE_DB_PASSWORD=replace_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://seat_store:replace_me@127.0.0.1:5432/seat_booking
TEST_DATABASE_URL=postgresql://seat_store:replace_me@127.0.0.1:5432/seat_booking_test
SEAT_MAP_TIER=dev
HOLD_TTL_SECONDS=300
EXPIRY_SCAN_INTERVAL=1
CALLBACK_INTERVAL=1
CALLBACK_TIMEOUT_SECONDS=5
WAITLIST_URL=http://127.0.0.1:5004
HOST=127.0.0.1
PORT=5003

