# Copy to src/waitlist-payment/.env.container (ignored). Never commit real secrets.
# Docker Desktop: host.docker.internal reaches services running on your computer.
# For a shared Docker network, replace these hosts with the agreed service names.
# URL-encode special characters in database credentials.
PAYMENT_DATABASE_URL=postgresql://payment_user:replace_me@host.docker.internal:5433/seat_booking
SEAT_STORE_URL=http://host.docker.internal:5003
SEAT_CANCEL_PATH=/seats/cancel
# Generate a private token of 32+ characters; share it with trusted callers only.
PAYMENT_API_TOKEN=replace_me_with_a_private_token_at_least_32_characters
# Optional independent signing key for the customer-scoped checkout routes.
PAYMENT_CHECKOUT_SIGNING_KEY=
PAYMENT_STATUS_URL=
PAYMENT_HTTP_TIMEOUT=5
PAYMENT_WORKER_INTERVAL=1
PAYMENT_HTTP_THREADS=8
PAYMENT_HTTP_CONNECTION_LIMIT=100
PAYMENT_DB_POOL_SIZE=8
PAYMENT_DB_POOL_WAITING=16
PAYMENT_DB_POOL_TIMEOUT=3
PAYMENT_RATE_LIMIT=600
PAYMENT_RATE_WINDOW_SECONDS=60
PAYMENT_MAX_PENDING=5000
PAYMENT_MAX_ATTEMPTS_PER_HOLD=10
PAYMENT_CUSTOMER_MOCK_OUTCOME=success
