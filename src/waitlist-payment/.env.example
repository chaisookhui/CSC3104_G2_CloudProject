# Independent payment configuration. Copy to this folder's ignored .env.
# For local compatibility, this may point to the existing project application DB.
PAYMENT_DATABASE_URL=postgresql://payment_user:replace_me@127.0.0.1:5433/seat_booking
PAYMENT_TEST_DATABASE_URL=postgresql://payment_user:replace_me@127.0.0.1:5433/seat_booking_test
SEAT_STORE_URL=http://127.0.0.1:5003
# Leave empty until the seat-store owner supplies a compatible exact-hold cancel API.
SEAT_CANCEL_PATH=
# Optional durable terminal-checkout event consumer; leave empty until agreed.
PAYMENT_STATUS_URL=
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=5004
PAYMENT_HTTP_TIMEOUT=5
PAYMENT_WORKER_INTERVAL=1
# Optional internal service credential. Existing expiry sender has no token support;
# configure its caller before enabling this. Does not authenticate end users.
PAYMENT_API_TOKEN=
