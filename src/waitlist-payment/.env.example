# Independent payment configuration. Copy to this folder's ignored .env.
# For local compatibility, this may point to the existing project application DB.
PAYMENT_DATABASE_URL=postgresql://payment_user:replace_me@127.0.0.1:5433/seat_booking
PAYMENT_TEST_DATABASE_URL=postgresql://payment_user:replace_me@127.0.0.1:5433/seat_booking_test
SEAT_STORE_URL=http://127.0.0.1:5003
# Available after applying seat-store migration 002.
SEAT_CANCEL_PATH=/seats/cancel
# Optional durable terminal-checkout event consumer; leave empty until agreed.
PAYMENT_STATUS_URL=
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=5004
PAYMENT_HTTP_TIMEOUT=5
PAYMENT_WORKER_INTERVAL=1
# Match in seat-store and waiting-room. Required (32+ chars) in Compose/Kubernetes.
# Local unauthenticated mode is for loopback development only; no end-user identity.
PAYMENT_API_TOKEN=
PAYMENT_REQUIRE_AUTH=false
PAYMENT_HTTP_THREADS=8
PAYMENT_HTTP_CONNECTION_LIMIT=100
PAYMENT_DB_POOL_SIZE=8
PAYMENT_DB_POOL_WAITING=16
PAYMENT_DB_POOL_TIMEOUT=3
# Separate shared quotas for reads, writes and callbacks; same values on all APIs.
PAYMENT_RATE_LIMIT=600
PAYMENT_RATE_WINDOW_SECONDS=60
PAYMENT_MAX_PENDING=5000
PAYMENT_MAX_ATTEMPTS_PER_HOLD=10
# Optional, independent 32+ character secret. Never use PAYMENT_API_TOKEN here.
PAYMENT_CHECKOUT_SIGNING_KEY=
# Customer JSON cannot choose its own outcome. This setting is for the simulator.
PAYMENT_CUSTOMER_MOCK_OUTCOME=success
# Optional gateway overlay: directory containing externally provisioned tls.crt/tls.key.
PAYMENT_TLS_DIR=
