# Reference only; export variables before starting (no implicit .env loading).
WAITING_ROOM_URL=http://127.0.0.1:5001
ALLOCATOR_URL=http://127.0.0.1:5002
DISPATCHER_PORT=5005
BATCH_SIZE=50
# Default local state is <repository>/.local/dispatcher.sqlite3.
# For multiple hosts/Pods set the SAME PostgreSQL URL on API and all workers:
# DISPATCHER_DATABASE_URL=postgresql://dispatcher:replace_me@postgres:5432/dispatcher
